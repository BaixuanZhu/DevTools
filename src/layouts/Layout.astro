---
import '../styles/global.css';
import SeoHead from '../components/seo/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object | object[];
  /** 页面关键词（透传到 SeoHead） */
  keywords?: string[];
}

const { title = 'DevTools 在线工具箱 - 50+ 款免费在线开发者工具', description, jsonLd, keywords } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://tools.baixuanz.cn';

/** 首页 WebSite 结构化数据 */
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DevTools',
  url: siteUrl,
  description: 'DevTools 免费在线开发者工具箱，收录文本编码、加密安全、格式转换、网络计算、日期时间、前端媒体与开发运维七大类常用小工具，覆盖 JSON 格式化、Base64 编解码、正则测试、时间戳转换、图片压缩等高频开发场景，纯浏览器端本地运算数据绝不上传。',
  inLanguage: 'zh-CN',
};

/** 合并 WebSite JSON-LD 与页面自定义 JSON-LD */
const allJsonLd: object[] = [websiteJsonLd];
if (jsonLd) {
  allJsonLd.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SeoHead title={title} description={description} jsonLd={allJsonLd} keywords={keywords} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- 提前建立与 Google Fonts 源的连接，减少 DNS/TCP/TLS 耗时 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 非阻塞加载字体 CSS：先以 preload 方式获取，加载完成后提升为 stylesheet -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;600&display=swap"
      />
    </noscript>
    <!-- 首帧前同步设置暗色 class，避免 FOUC（localStorage + prefers-color-scheme，须容错） -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('devtools-theme');
          var dark =
            saved === 'dark' ||
            (saved === 'system' || !saved
              ? window.matchMedia('(prefers-color-scheme: dark)').matches
              : false);
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground font-sans text-base leading-normal antialiased">
    <slot />
  </body>
</html>
