---
import type { ToolMeta } from '../../data/tools';

/**
 * 工具卡片（纯 Astro，零 JS）。
 *
 * 视觉/语义与 shadcn-vue Card 对齐：
 * - 根元素复用 Card.vue 的 `rounded-xl border bg-card text-card-foreground shadow`
 * - 标题用 CardTitle 的 `font-semibold leading-none tracking-tight` token
 * - 描述用 CardDescription 的 `text-sm text-muted-foreground` token
 *
 * 横向布局（icon 左 + 内容右），整卡 <a>，hover 提升边框与阴影。
 */
interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;
---

<a
  href={tool.path}
  target={tool.standalone ? '_blank' : undefined}
  rel={tool.standalone ? 'noopener noreferrer' : undefined}
  class="flex h-full w-full items-start gap-4 rounded-xl border border-border bg-card p-5 text-card-foreground shadow transition-[border-color,box-shadow] duration-150 hover:border-primary hover:shadow-md"
>
  <span class="mt-0.5 shrink-0 text-[1.75rem] leading-none">{tool.icon}</span>
  <div class="min-w-0 flex-1">
    <h3 class="mb-1 text-[0.9375rem] font-semibold leading-snug tracking-tight">{tool.name}</h3>
    <p class="m-0 text-[0.8125rem] leading-relaxed text-muted-foreground">{tool.description}</p>
  </div>
</a>
