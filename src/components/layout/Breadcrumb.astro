---
import { ChevronRight } from '@lucide/astro';

/**
 * 面包屑导航（纯 Astro，零 JS）。
 *
 * 视觉与 shadcn-vue Breadcrumb 对齐：
 * - nav: aria-label="breadcrumb"
 * - ol: flex flex-wrap items-center gap-1.5 text-sm
 * - item: inline-flex items-center gap-1.5（BreadcrumbItem token）
 * - 链接：transition-colors hover:text-foreground（BreadcrumbLink token），默认 text-muted-foreground
 * - 分隔符：ChevronRight（BreadcrumbSeparator 用 svg，此处用 @lucide/astro 等价）
 * - 当前页：font-normal text-foreground + aria-current="page"（BreadcrumbPage token）
 */
interface Props {
  /** 面包屑项列表 */
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="breadcrumb" class="mb-4">
  <ol class="m-0 flex list-none flex-wrap items-center gap-1.5 p-0 text-sm">
    {items.map((item, index) => (
      <>
        {index > 0 && (
          <li class="[&>svg]:size-3.5 text-muted-foreground" role="presentation" aria-hidden="true">
            <ChevronRight />
          </li>
        )}
        <li class="inline-flex items-center gap-1.5">
          {item.href ? (
            <a
              href={item.href}
              class="text-muted-foreground transition-colors hover:text-foreground"
            >
              {item.label}
            </a>
          ) : (
            <span class="font-normal text-foreground" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      </>
    ))}
  </ol>
</nav>
