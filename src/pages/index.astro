---
import ToolLayout from '../layouts/ToolLayout.astro';
import CategoryCard from '../components/layout/CategoryCard.astro';
import SearchPanel from '../components/shell/SearchPanel.vue';
import TypewriterText from '../components/layout/TypewriterText.vue';
import { categories } from '../data/categories';
import { getToolsByCategory } from '../data/tools';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://tools.baixuanz.cn';

/** 各分类工具数量 */
const toolsByCategory = getToolsByCategory();
const categoryCards = categories.map((c) => ({
  category: c,
  count: (toolsByCategory[c.name] || []).length,
}));

/** 全站工具总数（hero badge 展示） */
const totalTools = categoryCards.reduce((sum, c) => sum + c.count, 0);

/** 首页 meta description 与 ItemList JSON-LD 共用的站点描述（120-160 字符） */
const homeDescription =
  '免费在线开发者工具箱，收录文本编码、加密安全、格式转换、网络计算、日期时间、前端媒体与开发运维七大类常用小工具，覆盖 Base64 编解码、JSON 格式化、正则测试、时间戳转换、图片压缩与 Docker 配置生成等高频开发场景，即开即用无需注册，纯浏览器端本地运算数据绝不上传。';

/** 首页 ItemList：列出 7 个分类（CollectionPage），工具级链接下放到分类页 */
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'DevTools 在线工具箱',
  description: homeDescription,
  numberOfItems: categoryCards.length,
  itemListElement: categoryCards.map(({ category }, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: `${category.name}工具集合`,
    url: `${siteUrl}/${category.slug}`,
      description: category.seoDescription,
  })),
};
---

<ToolLayout title="DevTools 在线工具箱 - JSON、时间戳、图片压缩等 50+ 免费开发工具" description={homeDescription} jsonLd={itemListJsonLd}>
  <div class="mx-auto max-w-320">
    <!-- Hero Section：与 shadcn 视觉对齐（Badge + 大标题 + muted 副标题） -->
    <div class="mb-10 text-center">
      <div class="mb-4 inline-flex items-center rounded-md border border-transparent bg-secondary px-2.5 py-0.5 text-xs font-semibold tabular-nums text-secondary-foreground">
        共 {totalTools} 款工具 · {categoryCards.length} 个分类
      </div>
      <h1 class="m-0 mb-3 text-4xl font-bold tracking-tight text-foreground max-md:text-3xl">
        <TypewriterText text="在线工具箱" client:visible />
      </h1>
      <p class="m-0 mb-8 text-base text-muted-foreground">零门槛的浏览器端在线工具，即开即用</p>
    </div>

    <!-- 搜索面板（Vue 岛：输入实时匹配 tools → 下拉建议 → 选中直达 tool.path） -->
    <SearchPanel client:load />

    <!-- 分类卡片网格（7 个分类入口）：auto-fill 自适应移动/平板/桌面 -->
    <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-4 max-md:grid-cols-1">
      {categoryCards.map(({ category, count }) => (
        <CategoryCard category={category} count={count} />
      ))}
    </div>
  </div>
</ToolLayout>
